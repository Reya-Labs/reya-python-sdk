PERP_PRIVATE_KEY_2=
PERP_WALLET_ADDRESS_2=

# SPOT_ACCOUNT_ID_1 (spot maker)
SPOT_ACCOUNT_ID_1=
SPOT_PRIVATE_KEY_1=
SPOT_WALLET_ADDRESS_1=

# SPOT_ACCOUNT_ID_2 (spot taker)
